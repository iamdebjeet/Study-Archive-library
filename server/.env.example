# Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Any long random string. Must match VITE_API_KEY in the frontend's .env
API_KEY=choose-a-long-random-string-here

PORT=8787

# Comma-separated list of allowed frontend origins, e.g. https://your-app.vercel.app
# Leave unset to allow all origins.
FRONTEND_ORIGIN=http://localhost:5173
